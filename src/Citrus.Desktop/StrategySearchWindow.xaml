<Window x:Class="Citrus.Desktop.StrategySearchWindow" Style="{StaticResource {x:Type Window}}"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Find and replace" Width="670" Height="270" MinWidth="600" MinHeight="250" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
 PreviewKeyDown="SearchKeyDown">
 <Grid Margin="12">
  <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Label Content="Find" Target="{Binding ElementName=query}"/><TextBox x:Name="query" Grid.Column="1" Margin="3,5" AutomationProperties.Name="Find in strategy"/>
  <Label Grid.Row="1" Content="Replace with" Target="{Binding ElementName=replacement}"/><TextBox x:Name="replacement" Grid.Row="1" Grid.Column="1" Margin="3,5" AutomationProperties.Name="Replace in strategy"/>
  <WrapPanel Grid.Row="2" Grid.Column="1" Margin="0,8">
   <CheckBox x:Name="matchCase" Content="Match case" Margin="3"/>
   <CheckBox x:Name="wholeWord" Content="Whole word" Margin="3"/>
   <CheckBox x:Name="regex" Content="Regular expression" Margin="3"/>
  </WrapPanel>
  <WrapPanel Grid.Row="3" Grid.ColumnSpan="2">
   <Button Content="Find next" IsDefault="True" Tag="Next" Click="CommandClicked"/>
   <Button Content="Previous" Tag="Previous" Click="CommandClicked"/>
   <Button x:Name="replaceButton" Content="Replace" Tag="Replace" Click="CommandClicked"/>
   <Button x:Name="replaceAllButton" Content="Replace all" Tag="All" Click="CommandClicked"/>
   <Button Content="Close" Tag="Close" Click="CommandClicked"/>
  </WrapPanel>
  <TextBlock x:Name="message" Grid.Row="4" Grid.ColumnSpan="2" Margin="3,8" TextWrapping="Wrap" AutomationProperties.Name="Search result"/>
 </Grid>
</Window>
