<Window x:Class="Citrus.Desktop.ErrorWindow" Style="{StaticResource {x:Type Window}}"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Operation failed" Width="820" Height="480" MinWidth="600" MinHeight="360" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <DockPanel Margin="14">
  <TextBlock x:Name="summary" DockPanel.Dock="Top" Margin="0,0,0,12" TextWrapping="Wrap" Text="Error summary"/>
  <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
   <Button Content="Copy details" Click="CopyClicked"/><Button Content="Close" IsDefault="True" IsCancel="True" Click="CloseClicked"/>
  </StackPanel>
  <TextBox x:Name="details" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Error details"/>
 </DockPanel>
</Window>
