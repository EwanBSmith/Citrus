<UserControl x:Class="Citrus.Desktop.ConfigurationEditor"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
 mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="650">
 <UserControl.Resources>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="5,3"/><Setter Property="Margin" Value="3,5"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="Label"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,4"/></Style>
 </UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="16" Grid.IsSharedSizeScope="True">
   <TextBlock Text="Settings assigned in the strategy's Configure method are read-only. Save C# changes and Validate to refresh them; unassigned settings remain editable." TextWrapping="Wrap" Margin="0,0,0,14"/>
   <Expander Header="Advanced strategy paths" Padding="12" Margin="0,0,0,14" IsExpanded="False"><StackPanel>
    <TextBlock Text="Select a project to build, or a prebuilt DLL. Paths are relative to the workspace." TextWrapping="Wrap"/>
    <Label Content="Strategy project (.csproj)" Target="{Binding ElementName=StrategyProject}"/>
    <DockPanel><Button Content="Browse…" DockPanel.Dock="Right" Click="BrowseProject"/><TextBox x:Name="StrategyProject" TextChanged="FieldChanged"/></DockPanel>
    <Label Content="Prebuilt assembly (.dll; leave blank when using a project)" Target="{Binding ElementName=StrategyAssembly}"/>
    <TextBox x:Name="StrategyAssembly" TextChanged="FieldChanged"/>
    <Label Content="Strategy class (namespace and type name)" Target="{Binding ElementName=StrategyType}"/>
    <TextBox x:Name="StrategyType" TextChanged="FieldChanged"/>
    <Label Content="Solution to open in IDE (optional)" Target="{Binding ElementName=StrategySolution}"/>
    <DockPanel><Button Content="Browse…" DockPanel.Dock="Right" Click="BrowseSolution"/><TextBox x:Name="StrategySolution" TextChanged="FieldChanged"/></DockPanel>
   </StackPanel></Expander>
   <GroupBox Header="Files and output" Padding="12" Margin="0,0,0,14"><Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Label Grid.Row="0" Content="Output folder" Target="{Binding ElementName=Output}"/>
    <Grid Grid.Row="0" Grid.Column="1"><DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseOutput" Margin="4"/>
<TextBox x:Name="Output" TextChanged="FieldChanged" AutomationProperties.Name="Output folder" /></DockPanel></Grid>
    <Label Grid.Row="1" Content="Assembly references (one per line)" Target="{Binding ElementName=References}"/>
    <Grid Grid.Row="1" Grid.Column="1"><TextBox x:Name="References" TextChanged="FieldChanged" AutomationProperties.Name="Assembly references (one per line)" AcceptsReturn="True" Height="70" VerticalScrollBarVisibility="Auto"/></Grid>
   </Grid></GroupBox>
   <GroupBox Header="Historical data" Padding="12" Margin="0,0,0,14"><Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Label Grid.Row="0" Content="Start (UTC; blank for all history)" Target="{Binding ElementName=Start}"/>
    <Grid Grid.Row="0" Grid.Column="1"><TextBox x:Name="Start" TextChanged="FieldChanged" AutomationProperties.Name="Start (UTC; blank for all history)" ToolTip="ISO 8601 timestamp, for example 2024-01-01T00:00:00Z. Blank means no boundary."/></Grid>
    <Label Grid.Row="1" Content="End (UTC; exclusive, optional)" Target="{Binding ElementName=End}"/>
    <Grid Grid.Row="1" Grid.Column="1"><TextBox x:Name="End" TextChanged="FieldChanged" AutomationProperties.Name="End (UTC; exclusive, optional)" ToolTip="ISO 8601 timestamp, for example 2024-01-01T00:00:00Z. Blank means no boundary."/></Grid>
    <Label Grid.Row="2" Content="Bar interval" Target="{Binding ElementName=Interval}"/>
    <Grid Grid.Row="2" Grid.Column="1"><ComboBox x:Name="Interval" Margin="3,5" DisplayMemberPath="Name" SelectionChanged="FieldChanged" AutomationProperties.Name="Bar interval"/></Grid>
   </Grid></GroupBox>
   <GroupBox Header="Capital and reproducibility" Padding="12" Margin="0,0,0,14"><Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Label Grid.Row="0" Content="Initial Cash" Target="{Binding ElementName=InitialCash}"/>
    <Grid Grid.Row="0" Grid.Column="1"><TextBox x:Name="InitialCash" TextChanged="FieldChanged" AutomationProperties.Name="Initial Cash" ToolTip="Enter a number using a decimal point."/></Grid>
    <Label Grid.Row="1" Content="Seed" Target="{Binding ElementName=Seed}"/>
    <Grid Grid.Row="1" Grid.Column="1"><TextBox x:Name="Seed" TextChanged="FieldChanged" AutomationProperties.Name="Seed" ToolTip="Enter a number using a decimal point."/></Grid>
    <Label Grid.Row="2" Content="Risk-free rate (fraction)" Target="{Binding ElementName=RiskFreeRate}"/>
    <Grid Grid.Row="2" Grid.Column="1"><TextBox x:Name="RiskFreeRate" TextChanged="FieldChanged" AutomationProperties.Name="Risk-free rate (fraction)" ToolTip="Enter a number using a decimal point."/></Grid>
   </Grid></GroupBox>
   <GroupBox Header="Execution costs and borrowing" Padding="12" Margin="0,0,0,14"><Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Label Grid.Row="0" Content="Commission Fixed" Target="{Binding ElementName=CommissionFixed}"/>
    <Grid Grid.Row="0" Grid.Column="1"><TextBox x:Name="CommissionFixed" TextChanged="FieldChanged" AutomationProperties.Name="Commission Fixed" ToolTip="Enter a number using a decimal point."/></Grid>
    <Label Grid.Row="1" Content="Commission Per Unit" Target="{Binding ElementName=CommissionPerUnit}"/>
    <Grid Grid.Row="1" Grid.Column="1"><TextBox x:Name="CommissionPerUnit" TextChanged="FieldChanged" AutomationProperties.Name="Commission Per Unit" ToolTip="Enter a number using a decimal point."/></Grid>
    <Label Grid.Row="2" Content="Spread (basis points)" Target="{Binding ElementName=SpreadBps}"/>
    <Grid Grid.Row="2" Grid.Column="1"><TextBox x:Name="SpreadBps" TextChanged="FieldChanged" AutomationProperties.Name="Spread (basis points)" ToolTip="Enter a number using a decimal point."/></Grid>
    <Label Grid.Row="3" Content="Slippage (basis points)" Target="{Binding ElementName=SlippageBps}"/>
    <Grid Grid.Row="3" Grid.Column="1"><TextBox x:Name="SlippageBps" TextChanged="FieldChanged" AutomationProperties.Name="Slippage (basis points)" ToolTip="Enter a number using a decimal point."/></Grid>
    <Label Grid.Row="4" Content="Rejection probability (0–1)" Target="{Binding ElementName=RejectionProbability}"/>
    <Grid Grid.Row="4" Grid.Column="1"><TextBox x:Name="RejectionProbability" TextChanged="FieldChanged" AutomationProperties.Name="Rejection probability (0–1)" ToolTip="Enter a number using a decimal point."/></Grid>
    <Label Grid.Row="5" Content="Annual borrow rate (fraction)" Target="{Binding ElementName=AnnualBorrowRate}"/>
    <Grid Grid.Row="5" Grid.Column="1"><TextBox x:Name="AnnualBorrowRate" TextChanged="FieldChanged" AutomationProperties.Name="Annual borrow rate (fraction)" ToolTip="Enter a number using a decimal point."/></Grid>
    <Label Grid.Row="6" Content="Shorts Available" Target="{Binding ElementName=ShortsAvailable}"/>
    <Grid Grid.Row="6" Grid.Column="1"><CheckBox x:Name="ShortsAvailable" Content="Enabled" Margin="3,8" Checked="FieldChanged" Unchecked="FieldChanged" AutomationProperties.Name="Shorts Available"/></Grid>
   </Grid></GroupBox>
   <GroupBox Header="Margin requirements" Padding="12" Margin="0,0,0,14"><Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Label Grid.Row="0" Content="Equity Initial Margin" Target="{Binding ElementName=EquityInitialMargin}"/>
    <Grid Grid.Row="0" Grid.Column="1"><TextBox x:Name="EquityInitialMargin" TextChanged="FieldChanged" AutomationProperties.Name="Equity Initial Margin" ToolTip="Enter a number using a decimal point."/></Grid>
    <Label Grid.Row="1" Content="Equity Maintenance Margin" Target="{Binding ElementName=EquityMaintenanceMargin}"/>
    <Grid Grid.Row="1" Grid.Column="1"><TextBox x:Name="EquityMaintenanceMargin" TextChanged="FieldChanged" AutomationProperties.Name="Equity Maintenance Margin" ToolTip="Enter a number using a decimal point."/></Grid>
    <Label Grid.Row="2" Content="Perpetual Initial Margin" Target="{Binding ElementName=PerpetualInitialMargin}"/>
    <Grid Grid.Row="2" Grid.Column="1"><TextBox x:Name="PerpetualInitialMargin" TextChanged="FieldChanged" AutomationProperties.Name="Perpetual Initial Margin" ToolTip="Enter a number using a decimal point."/></Grid>
    <Label Grid.Row="3" Content="Perpetual Maintenance Margin" Target="{Binding ElementName=PerpetualMaintenanceMargin}"/>
    <Grid Grid.Row="3" Grid.Column="1"><TextBox x:Name="PerpetualMaintenanceMargin" TextChanged="FieldChanged" AutomationProperties.Name="Perpetual Maintenance Margin" ToolTip="Enter a number using a decimal point."/></Grid>
   </Grid></GroupBox>
  </StackPanel>
 </ScrollViewer>
</UserControl>
